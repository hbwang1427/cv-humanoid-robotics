<?xml version="1.0"?>
<robot name="humanoid">

  <!-- =========================================================
       MATERIALS
  ========================================================= -->
  <material name="grey">  <color rgba="0.6 0.6 0.6 1"/> </material>
  <material name="blue">  <color rgba="0.2 0.4 0.8 1"/> </material>
  <material name="green"> <color rgba="0.2 0.8 0.2 1"/> </material>

  <!-- =========================================================
       LINKS
  ========================================================= -->

  <!-- Torso / base -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.25 0.15 0.35"/></geometry>
      <material name="blue"/>
    </visual>
    <collision><geometry><box size="0.25 0.15 0.35"/></geometry></collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <!-- Head -->
  <link name="head">
    <visual>
      <geometry><sphere radius="0.1"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><geometry><sphere radius="0.1"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <!-- Left upper arm -->
  <link name="left_upper_arm">
    <visual>
      <origin xyz="0 0 -0.15"/>
      <geometry><cylinder radius="0.035" length="0.3"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><origin xyz="0 0 -0.15"/><geometry><cylinder radius="0.035" length="0.3"/></geometry></collision>
    <inertial><mass value="1.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.002"/></inertial>
  </link>

  <!-- Left lower arm -->
  <link name="left_lower_arm">
    <visual>
      <origin xyz="0 0 -0.13"/>
      <geometry><cylinder radius="0.03" length="0.26"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><origin xyz="0 0 -0.13"/><geometry><cylinder radius="0.03" length="0.26"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.001"/></inertial>
  </link>

  <!-- Right upper arm -->
  <link name="right_upper_arm">
    <visual>
      <origin xyz="0 0 -0.15"/>
      <geometry><cylinder radius="0.035" length="0.3"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><origin xyz="0 0 -0.15"/><geometry><cylinder radius="0.035" length="0.3"/></geometry></collision>
    <inertial><mass value="1.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.002"/></inertial>
  </link>

  <!-- Right lower arm -->
  <link name="right_lower_arm">
    <visual>
      <origin xyz="0 0 -0.13"/>
      <geometry><cylinder radius="0.03" length="0.26"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><origin xyz="0 0 -0.13"/><geometry><cylinder radius="0.03" length="0.26"/></geometry></collision>
    <inertial><mass value="1.0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.001"/></inertial>
  </link>

  <!-- Left thigh -->
  <link name="left_thigh">
    <visual>
      <origin xyz="0 0 -0.2"/>
      <geometry><cylinder radius="0.045" length="0.4"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><origin xyz="0 0 -0.2"/><geometry><cylinder radius="0.045" length="0.4"/></geometry></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.003"/></inertial>
  </link>

  <!-- Left shin -->
  <link name="left_shin">
    <visual>
      <origin xyz="0 0 -0.19"/>
      <geometry><cylinder radius="0.035" length="0.38"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><origin xyz="0 0 -0.19"/><geometry><cylinder radius="0.035" length="0.38"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.002"/></inertial>
  </link>

  <!-- Right thigh -->
  <link name="right_thigh">
    <visual>
      <origin xyz="0 0 -0.2"/>
      <geometry><cylinder radius="0.045" length="0.4"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><origin xyz="0 0 -0.2"/><geometry><cylinder radius="0.045" length="0.4"/></geometry></collision>
    <inertial><mass value="3.0"/><inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.003"/></inertial>
  </link>

  <!-- Right shin -->
  <link name="right_shin">
    <visual>
      <origin xyz="0 0 -0.19"/>
      <geometry><cylinder radius="0.035" length="0.38"/></geometry>
      <material name="grey"/>
    </visual>
    <collision><origin xyz="0 0 -0.19"/><geometry><cylinder radius="0.035" length="0.38"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.002"/></inertial>
  </link>

  <!-- =========================================================
       JOINTS
  ========================================================= -->

  <!-- Head -->
  <joint name="head_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="head"/>
    <origin xyz="0 0 0.225"/>
  </joint>

  <!-- Left shoulder (pitch = sagittal plane, forward/back) -->
  <joint name="left_shoulder_pitch" type="revolute">
    <parent link="base_link"/>
    <child  link="left_upper_arm"/>
    <origin xyz="0.145 0 0.15"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="3"/>
  </joint>

  <!-- Left elbow -->
  <joint name="left_elbow" type="revolute">
    <parent link="left_upper_arm"/>
    <child  link="left_lower_arm"/>
    <origin xyz="0 0 -0.3"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="2.35" effort="20" velocity="3"/>
  </joint>

  <!-- Right shoulder pitch -->
  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="base_link"/>
    <child  link="right_upper_arm"/>
    <origin xyz="-0.145 0 0.15"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="30" velocity="3"/>
  </joint>

  <!-- Right elbow -->
  <joint name="right_elbow" type="revolute">
    <parent link="right_upper_arm"/>
    <child  link="right_lower_arm"/>
    <origin xyz="0 0 -0.3"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="2.35" effort="20" velocity="3"/>
  </joint>

  <!-- Left hip pitch -->
  <joint name="left_hip_pitch" type="revolute">
    <parent link="base_link"/>
    <child  link="left_thigh"/>
    <origin xyz="0.09 0 -0.175"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="3"/>
  </joint>

  <!-- Left knee -->
  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/>
    <child  link="left_shin"/>
    <origin xyz="0 0 -0.4"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="2.35" effort="40" velocity="3"/>
  </joint>

  <!-- Right hip pitch -->
  <joint name="right_hip_pitch" type="revolute">
    <parent link="base_link"/>
    <child  link="right_thigh"/>
    <origin xyz="-0.09 0 -0.175"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="50" velocity="3"/>
  </joint>

  <!-- Right knee -->
  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/>
    <child  link="right_shin"/>
    <origin xyz="0 0 -0.4"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="2.35" effort="40" velocity="3"/>
  </joint>

</robot>
